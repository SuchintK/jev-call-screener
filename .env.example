# Server
PORT=8080
PUBLIC_BASE_URL=https://example.com

# TypeSafe / JEV
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=3000

# Routing
PROMOTIONAL_REJECT_THRESHOLD=0.90
WANTED_FORWARD_THRESHOLD=0.75
MAX_CLARIFICATION_TURNS=1
FORWARD_ON_ERROR=true

# Telephony
TELEPHONY_PROVIDER=twilio

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FORWARD_TO_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true

# Privacy
LOG_TRANSCRIPTS=false

# Optional custom screening rules and messages
SCREENING_CONFIG_PATH=
